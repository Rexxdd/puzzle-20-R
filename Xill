-- 3. LOGIKA EKSEKUSI & INTERAKSI UI
-- =========================================================================

local function setStatus(text, color)
    StatusBadge.Text = text
    StatusBadge.BackgroundColor3 = color or Color3.fromRGB(45, 52, 68)
end

local function setProgressBar(percent)
    percent = math.clamp(percent, 0, 1)
    TweenService:Create(ProgressFill, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(percent, 0, 1, 0)
    }):Play()
end

local function startSolving()
    if isRunning then return end
    isRunning = true
    shouldStop = false

    StartBtn.Text = "Hentikan (Stop)"
    StartBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    setStatus("CALCULATING", Color3.fromRGB(210, 140, 20))
    PhaseLabel.Text = "Tahap: Menghitung Solusi..."
    DetailLabel.Text = "Mengambil data puzzle dari server..."
    setProgressBar(0)

    task.spawn(function()
        local spawner = workspace:FindFirstChild("FinalePuzzleSpawner")
        local req = spawner and spawner:FindFirstChild("RequestPuzzle")
        local moveRemote = spawner and spawner:FindFirstChild("MovePuzzle")

        if not req or not moveRemote then
            DetailLabel.Text = "Gagal: RemoteFunction tidak ditemukan."
            setStatus("ERROR", Color3.fromRGB(200, 40, 40))
            isRunning = false
            StartBtn.Text = "Mulai Selesaikan"
            StartBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 255)
            return
        end

        local g, w, h, seed, solved = req:InvokeServer()
        if solved then
            PhaseLabel.Text = "Tahap: Sudah Terselesaikan!"
            DetailLabel.Text = "Puzzle sudah selesai di server."
            setStatus("SOLVED", Color3.fromRGB(40, 180, 80))
            setProgressBar(1)
            isRunning = false
            StartBtn.Text = "Mulai Selesaikan"
            StartBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 255)
            return
        end

        local cur_board = {}
        for y = 1, h do
            cur_board[y] = {}
            for x = 1, w do
                cur_board[y][x] = g[x][y].i
            end
        end

        -- Hitung langkah
        local ok, moves = pcall(function()
            return solve_puzzle(cur_board, w, h, function(phaseName)
                PhaseLabel.Text = "Tahap: " .. phaseName
            end)
        end)

        if not ok or not moves then
            DetailLabel.Text = "Gagal menghitung langkah solusi."
            setStatus("ERROR", Color3.fromRGB(200, 40, 40))
            isRunning = false
            StartBtn.Text = "Mulai Selesaikan"
            StartBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 255)
            return
        end

        local totalMoves = #moves
        setStatus("RUNNING", Color3.fromRGB(0, 150, 255))
        DetailLabel.Text = "Mengirim gerakan ke server..."

        local startTime = os.time()
        local timeConn
        timeConn = task.spawn(function()
            while isRunning do
                local elapsed = os.time() - startTime
                local mins = math.floor(elapsed / 60)
                local secs = elapsed % 60
                TimeLabel.Text = string.format("Waktu: %02d:%02d", mins, secs)
                task.wait(1)
            end
        end)

        local is_solved = false
        local retries = 0

        for i, m in ipairs(moves) do
            if shouldStop then
                DetailLabel.Text = "Dibatalkan oleh pengguna."
                setStatus("STOPPED", Color3.fromRGB(150, 150, 150))
                break
            end

            local d, old_x, old_y = m[1], m[2], m[3]

            -- Loop kirim gerakan dengan retry otomatis
            while not shouldStop do
                local success, res = moveRemote:InvokeServer(d, old_x, old_y)
                if success then
                    if res == true then is_solved = true end
                    break
                else
                    retries = retries + 1
                    task.wait(0.06)
                end
            end

            -- Update UI
            local pct = i / totalMoves
            setProgressBar(pct)
            MovesLabel.Text = string.format("Langkah: %d / %d (%.1f%%)", i, totalMoves, pct * 100)
            DetailLabel.Text = string.format("Proses bergerak... (Retries: %d)", retries)

            if is_solved then
                setProgressBar(1)
                MovesLabel.Text = string.format("Langkah: %d / %d (100%%)", totalMoves, totalMoves)
                PhaseLabel.Text = "Tahap: Selesai!"
                DetailLabel.Text = "Selamat! Puzzle berhasil dipecahkan."
                setStatus("SOLVED", Color3.fromRGB(40, 200, 90))
                break
            end

            task.wait(0.05)
        end

        isRunning = false
        StartBtn.Text = "Mulai Selesaikan"
        StartBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 255)
        req:InvokeServer()
    end)
end

local function stopSolving()
    if not isRunning then return end
    shouldStop = true
    DetailLabel.Text = "Menghentikan..."
end

-- Hubungkan Event Tombol
StartBtn.MouseButton1Click:Connect(function()
    if isRunning then
        stopSolving()
    else
        startSolving()
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    stopSolving()
    ScreenGui:Destroy()
end)

print("[PuzzleSolver] UI Berhasil dimuat ke layar!")
