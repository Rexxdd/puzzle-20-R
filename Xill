-- =========================================================================
-- 2. ALGORITMA PENYELESAIAN PUZZLE
-- =========================================================================

local isRunning = false
local shouldStop = false

local DIRS = {
    [1] = {0, -1}, -- UP
    [2] = {-1, 0}, -- LEFT
    [3] = {0, 1},  -- DOWN
    [4] = {1, 0}   -- RIGHT
}

local function get_target_val(x, y, height)
    return (x - 1) * height + y
end

local function solve_puzzle(initial_board, width, height, updatePhaseCallback)
    local board = {}
    for y = 1, height do
        board[y] = {}
        for x = 1, width do
            board[y][x] = initial_board[y][x]
        end
    end
    
    local blank_val = width * height
    local bx, by
    for y = 1, height do
        for x = 1, width do
            if board[y][x] == blank_val then
                bx, by = x, y
                break
            end
        end
    end
    
    local moves = {}
    local locked = {}

    local function is_locked(x, y) return locked[x .. "," .. y] == true end
    local function lock(x, y) locked[x .. "," .. y] = true end

    local function do_move(d)
        local dir = DIRS[d]
        local nx, ny = bx + dir[1], by + dir[2]
        table.insert(moves, {d, bx, by})
        board[by][bx] = board[ny][nx]
        board[ny][nx] = blank_val
        bx, by = nx, ny
    end

    local function find_tile(val)
        for y = 1, height do
            for x = 1, width do
                if board[y][x] == val then return x, y end
            end
        end
        error("Tile tidak ditemukan: " .. tostring(val))
    end

    local function move_tile_to(val, target_tx, target_ty, forbidden_extra)
        forbidden_extra = forbidden_extra or {}
        local start_tx, start_ty = find_tile(val)
        if start_tx == target_tx and start_ty == target_ty then return end

        local function encode(tx, ty, b_x, b_y)
            return tx + ty * 10 + b_x * 100 + b_y * 1000
        end

        local start_code = encode(start_tx, start_ty, bx, by)
        local queue = {{tx = start_tx, ty = start_ty, bx = bx, by = by, path = {}}}
        local visited = {[start_code] = true}
        local head = 1
        local found_path = nil

        while head <= #queue do
            local cur = queue[head]
            head = head + 1
            if cur.tx == target_tx and cur.ty == target_ty then
                found_path = cur.path
                break
            end

            for d, dir in ipairs(DIRS) do
                local nbx, nby = cur.bx + dir[1], cur.by + dir[2]
                if nbx >= 1 and nbx <= width and nby >= 1 and nby <= height then
                    local bkey = nbx .. "," .. nby
                    if not is_locked(nbx, nby) and not forbidden_extra[bkey] then
                        local ntx, nty = cur.tx, cur.ty
                        if nbx == cur.tx and nby == cur.ty then
                            ntx, nty = cur.bx, cur.by
                        end

                        local code = encode(ntx, nty, nbx, nby)
                        if not visited[code] then
                            visited[code] = true
                            local np = table.create(#cur.path + 1)
                            for i, p in ipairs(cur.path) do np[i] = p end
                            np[#cur.path + 1] = d
                            table.insert(queue, {tx = ntx, ty = nty, bx = nbx, by = nby, path = np})
                        end
                    end
                end
            end
        end

        if not found_path then error("Gagal memindahkan tile " .. val) end
        for _, d in ipairs(found_path) do do_move(d) end
    end

    local function move_blank_to(target_bx, target_by, forbidden_extra)
        forbidden_extra = forbidden_extra or {}
        if bx == target_bx and by == target_by then return end

        local queue = {{bx = bx, by = by, path = {}}}
        local visited = {[bx .. "," .. by] = true}
        local head = 1
        local found_path = nil

        while head <= #queue do
            local cur = queue[head]
            head = head + 1
            if cur.bx == target_bx and cur.by == target_by then
                found_path = cur.path
                break
            end

            for d, dir in ipairs(DIRS) do
                local nbx, nby = cur.bx + dir[1], cur.by + dir[2]
                local bkey = nbx .. "," .. nby
                if nbx >= 1 and nbx <= width and nby >= 1 and nby <= height then
                    if not is_locked(nbx, nby) and not forbidden_extra[bkey] and not visited[bkey] then
                        visited[bkey] = true
                        local np = table.create(#cur.path + 1)
                        for i, p in ipairs(cur.path) do np[i] = p end
                        np[#cur.path + 1] = d
                        table.insert(queue, {bx = nbx, by = nby, path = np})
                    end
                end
            end
        end

        if not found_path then error("Gagal memindahkan blank") end
        for _, d in ipairs(found_path) do do_move(d) end
    end

    local function solve_simple_tile(tx, ty)
        local val = get_target_val(tx, ty, height)
        move_tile_to(val, tx, ty)
        lock(tx, ty)
    end

    local function solve_row_last_two(r, min_c, max_c)
        local t1_val = get_target_val(max_c - 1, r, height)
        local t2_val = get_target_val(max_c, r, height)

        local t1_x, t1_y = find_tile(t1_val)
        local t2_x, t2_y = find_tile(t2_val)
        if t1_x == max_c - 1 and t1_y == r and t2_x == max_c and t2_y == r then
            lock(max_c - 1, r)
            lock(max_c, r)
            return
        end

        local park_y = math.min(height, r + 2)
        move_tile_to(t2_val, max_c - 1, park_y)
        move_tile_to(t1_val, max_c, r, {[ (max_c - 1) .. "," .. park_y ] = true})
        move_tile_to(t2_val, max_c, r + 1, {[ max_c .. "," .. r ] = true})
        move_blank_to(max_c - 1, r, {
            [max_c .. "," .. r] = true,
            [max_c .. "," .. (r + 1)] = true
        })

        do_move(4)
        do_move(3)

        lock(max_c - 1, r)
        lock(max_c, r)
    end

    local function solve_col_last_two(c, min_r, max_r)
        local t1_val = get_target_val(c, max_r - 1, height)
        local t2_val = get_target_val(c, max_r, height)

        local t1_x, t1_y = find_tile(t1_val)
        local t2_x, t2_y = find_tile(t2_val)
        if t1_x == c and t1_y == max_r - 1 and t2_x == c and t2_y == max_r then
            lock(c, max_r - 1)
            lock(c, max_r)
            return
        end

        local park_x = math.min(width, c + 2)
        move_tile_to(t2_val, park_x, max_r - 1)
        move_tile_to(t1_val, c, max_r, {[ park_x .. "," .. (max_r - 1) ] = true})
        move_tile_to(t2_val, c + 1, max_r, {[ c .. "," .. max_r ] = true})
        move_blank_to(c, max_r - 1, {
            [c .. "," .. max_r] = true,
            [(c + 1) .. "," .. max_r] = true
        })

        do_move(3)
        do_move(4)

        lock(c, max_r - 1)
        lock(c, max_r)
    end

    local function solve_3x3_astar(ox, oy)
        if bx < ox or by < oy then move_blank_to(ox, oy) end

        local goal = {}
        local initial_state = {}
        local blank_idx = 0
        
        for y = 1, 3 do
            for x = 1, 3 do
                local gx = ox + x - 1
                local gy = oy + y - 1
                local target_val = (gx - 1) * height + gy
                goal[(y - 1) * 3 + x] = target_val
                local cur_val = board[gy][gx]
                initial_state[(y - 1) * 3 + x] = cur_val
                if cur_val == blank_val then blank_idx = (y - 1) * 3 + x end
            end
        end

        local function h_score(state)
            local h = 0
            for i = 1, 9 do
                local v = state[i]
                if v ~= blank_val then
                    for gi = 1, 9 do
                        if goal[gi] == v then
                            local cx = (i - 1) % 3
                            local cy = (i - 1) // 3
                            local g_x = (gi - 1) % 3
                            local g_y = (gi - 1) // 3
                            h = h + math.abs(cx - g_x) + math.abs(cy - g_y)
                            break
                        end
                    end
                end
            end
            return h
        end

        local function state_to_key(state) return table.concat(state, ",") end
        local target_key = state_to_key(goal)
        if state_to_key(initial_state) == target_key then return end

        local open_set = {{state = initial_state, b_idx = blank_idx, path = {}, g = 0, f = h_score(initial_state)}}
        local visited = {[state_to_key(initial_state)] = 0}
        local found_path = nil

        while #open_set > 0 do
            local min_i = 1
            local min_f = open_set[1].f
            for i = 2, #open_set do
                if open_set[i].f < min_f then
                    min_f = open_set[i].f
                    min_i = i
                end
            end
            local cur = table.remove(open_set, min_i)

            if state_to_key(cur.state) == target_key then
                found_path = cur.path
                break
            end

            local cx = (cur.b_idx - 1) % 3 + 1
            local cy = (cur.b_idx - 1) // 3 + 1

            for d, dir in ipairs(DIRS) do
                local nbx = cx + dir[1]
                local nby = cy + dir[2]
                if nbx >= 1 and nbx <= 3 and nby >= 1 and nby <= 3 then
                    local n_bidx = (nby - 1) * 3 + nbx
                    local nstate = table.create(9)
                    for i = 1, 9 do nstate[i] = cur.state[i] end
                    nstate[cur.b_idx] = nstate[n_bidx]
                    nstate[n_bidx] = blank_val

                    local key = state_to_key(nstate)
                    local ng = cur.g + 1
                    if not visited[key] or ng < visited[key] then
                        visited[key] = ng
                        local nf = ng + h_score(nstate)
                        local npath = table.create(#cur.path + 1)
                        for i, p in ipairs(cur.path) do npath[i] = p end
                        npath[#cur.path + 1] = d
                        table.insert(open_set, {state = nstate, b_idx = n_bidx, path = npath, g = ng, f = nf})
                    end
                end
            end
        end

        if not found_path then error("3x3 A* gagal!") end
        for _, d in ipairs(found_path) do do_move(d) end
    end

    -- Hitung langkah untuk baris & kolom 1 s/d 5
    for k = 1, width - 3 do
        if updatePhaseCallback then updatePhaseCallback("Menyusun Baris " .. k) end
        for x = k, width - 2 do solve_simple_tile(x, k) end
        solve_row_last_two(k, k, width)

        if updatePhaseCallback then updatePhaseCallback("Menyusun Kolom " .. k) end
        for y = k + 1, height - 2 do solve_simple_tile(k, y) end
        solve_col_last_two(k, k + 1, height)
    end

    if updatePhaseCallback then updatePhaseCallback("Menyusun Subgrid 3x3 (A*)") end
    solve_3x3_astar(width - 2, height - 2)
    
    return moves
end

